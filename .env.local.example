# Supabase - required for database-backed routes
# Get the URL and anon/publishable key from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Server-only; never use a NEXT_PUBLIC_ prefix.
# Only retrieve/configure this if a trusted server route needs admin access.
SUPABASE_SERVICE_ROLE_KEY=

# Parent portal destination; defaults to the current school portal if blank.
NEXT_PUBLIC_PARENT_PORTAL_URL=

# Africa's Talking SMS - optional; integration is not configured in this app yet.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# M-Pesa Daraja - optional; integration is not configured in this app yet.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=